generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  assigned
  in_progress
  completed
  cancelled
}

enum InvoiceStatus {
  unpaid
  paid
  void
}

enum TechnicianStatus {
  available
  busy
  offline
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  role                String               @default("user")
  isBlocked           Boolean              @default(false)
  phone               String?
  address             String?
  createdAt           DateTime             @default(now())
  bookings            Booking[]
  invoices            Invoice[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  feedbacks           Feedback[]
}

model Service {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String?   @unique
  imageUrl    String?
  category    String
  basePrice   Float
  duration    Int
  pricingType String    @default("fixed")
  createdAt   DateTime  @default(now())
  bookings    Booking[]
  addOns      AddOn[]
}

model AddOn {
  id        String  @id @default(uuid())
  name      String
  price     Float
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Technician {
  id        String           @id @default(uuid())
  name      String
  phone     String
  skills    String[]
  status    TechnicianStatus @default(available)
  createdAt DateTime         @default(now())
  bookings  Booking[]
}

model Booking {
  id           String        @id @default(uuid())
  userId       String
  serviceId    String
  technicianId String?
  date         DateTime
  time         String
  status       BookingStatus @default(pending)
  address      String
  phone        String
  notes        String?
  addOnIds     String[]      @default([])
  baseAmount   Float         @default(0)
  urgencyFee   Float         @default(0)
  distanceFee  Float         @default(0)
  addonsFee    Float         @default(0)
  distanceKm   Float         @default(0)
  price        Float
  createdAt    DateTime      @default(now())
  invoice      Invoice?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@unique([serviceId, date, time])
  @@index([date, time])
  @@index([userId])
  @@index([technicianId])
}

model Invoice {
  id        String        @id @default(uuid())
  bookingId String        @unique
  userId    String
  amount    Float
  status    InvoiceStatus @default(unpaid)
  issuedAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum FeedbackStatus {
  new
  read
  archived
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String?
  name      String?
  email     String?
  message   String
  status    FeedbackStatus @default(new)
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
